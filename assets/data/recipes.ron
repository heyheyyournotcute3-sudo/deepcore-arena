// Deepcore recipes.
//
// `machine` is the machine that runs the recipe, or "workbench" for hand
// crafting. `time` is seconds. `tech` gates availability behind the tech tree.
// `power_kw` is only meaningful for electric machines.

[
    // ================================================== workbench: era 0-1
    (id: "craft_ladder", machine: "workbench", time: 1.0,
        inputs: [("timber", 4)], outputs: [("ladder", 4)], tech: "mining_basics"),
    (id: "craft_timber_support", machine: "workbench", time: 1.0,
        inputs: [("timber", 6)], outputs: [("timber_support", 4)], tech: "mining_basics"),
    (id: "craft_oil_lamp", machine: "workbench", time: 2.0,
        inputs: [("clay", 2), ("coal", 1), ("timber", 1)], outputs: [("oil_lamp", 1)],
        tech: "mining_basics"),
    (id: "craft_oil_headlamp", machine: "workbench", time: 2.0,
        inputs: [("clay", 2), ("coal", 2)], outputs: [("oil_headlamp", 1)], tech: "mining_basics"),
    (id: "craft_stone_bricks", machine: "workbench", time: 2.0,
        inputs: [("stone_cobble", 4)], outputs: [("stone_bricks", 4)], tech: "mining_basics"),
    (id: "craft_brick_block", machine: "workbench", time: 2.0,
        inputs: [("brick", 4)], outputs: [("brick_block", 1)], tech: "kiln_work"),
    (id: "craft_glass_block", machine: "workbench", time: 2.0,
        inputs: [("glass_pane", 2)], outputs: [("glass_block", 1)], tech: "kiln_work"),
    (id: "craft_cast_mold", machine: "workbench", time: 2.0,
        inputs: [("sand", 4), ("clay", 2)], outputs: [("cast_mold", 1)], tech: "kiln_work"),
    (id: "craft_concrete", machine: "workbench", time: 3.0,
        inputs: [("limestone", 2), ("sand", 2), ("gravel", 2)], outputs: [("concrete", 4)],
        tech: "smelting"),

    // ================================================== brick kiln: era 1
    (id: "fire_brick", machine: "brick_kiln", time: 8.0,
        inputs: [("clay", 2)], outputs: [("brick", 2)], tech: "kiln_work"),
    (id: "fire_brick_hard", machine: "brick_kiln", time: 12.0,
        inputs: [("brick", 2), ("sand", 1)], outputs: [("fire_brick", 1)], tech: "kiln_work"),
    (id: "kiln_glass", machine: "brick_kiln", time: 10.0,
        inputs: [("sand", 2), ("coal", 1)], outputs: [("glass_pane", 2)], tech: "kiln_work"),

    // ================================================== stone furnace: era 1
    (id: "smelt_copper", machine: "stone_furnace", time: 6.0,
        inputs: [("raw_copper", 1)], outputs: [("copper_ingot", 1)], tech: "smelting"),
    (id: "smelt_tin", machine: "stone_furnace", time: 6.0,
        inputs: [("raw_tin", 1)], outputs: [("tin_ingot", 1)], tech: "smelting"),
    (id: "smelt_iron", machine: "stone_furnace", time: 7.0,
        inputs: [("raw_iron", 1)], outputs: [("iron_ingot", 1)], tech: "smelting"),
    (id: "smelt_lead", machine: "stone_furnace", time: 7.0,
        inputs: [("raw_lead", 1)], outputs: [("lead_ingot", 1)], tech: "smelting"),
    (id: "smelt_zinc", machine: "stone_furnace", time: 7.0,
        inputs: [("raw_zinc", 1)], outputs: [("zinc_ingot", 1), ("cadmium", 1)], tech: "smelting"),
    (id: "smelt_bronze", machine: "stone_furnace", time: 8.0,
        inputs: [("copper_ingot", 3), ("tin_ingot", 1)], outputs: [("bronze_ingot", 4)],
        tech: "bronze_working"),

    // ================================================== anvil: era 1
    (id: "forge_copper_plate", machine: "anvil", time: 4.0,
        inputs: [("copper_ingot", 2)], outputs: [("copper_plate", 1)], tech: "smithing"),
    (id: "forge_iron_plate", machine: "anvil", time: 4.0,
        inputs: [("iron_ingot", 2)], outputs: [("iron_plate", 1)], tech: "smithing"),
    (id: "forge_lead_plate", machine: "anvil", time: 4.0,
        inputs: [("lead_ingot", 2)], outputs: [("lead_plate", 1)], tech: "smithing"),
    (id: "forge_rods", machine: "anvil", time: 3.0,
        inputs: [("iron_ingot", 1)], outputs: [("iron_rod", 2)], tech: "smithing"),
    (id: "forge_copper_rod", machine: "anvil", time: 3.0,
        inputs: [("copper_ingot", 1)], outputs: [("copper_rod", 2)], tech: "smithing"),
    (id: "forge_bronze_gear", machine: "anvil", time: 5.0,
        inputs: [("bronze_ingot", 2)], outputs: [("bronze_gear", 1)], tech: "bronze_working"),
    (id: "forge_copper_pipe", machine: "anvil", time: 4.0,
        inputs: [("copper_plate", 1)], outputs: [("copper_pipe", 2)], tech: "steam_power"),
    (id: "forge_copper_wire", machine: "anvil", time: 3.0,
        inputs: [("copper_rod", 1)], outputs: [("copper_wire", 3)], tech: "electric_power"),
    (id: "forge_timber_support", machine: "anvil", time: 2.0,
        inputs: [("timber", 6)], outputs: [("timber_support", 4)], tech: "mining_basics"),

    // ================================================== blast furnace: era 1-2
    (id: "smelt_steel", machine: "blast_furnace", time: 12.0,
        inputs: [("iron_ingot", 2), ("coal", 2), ("limestone", 1)], outputs: [("steel_ingot", 2)],
        tech: "steelmaking"),
    (id: "forge_steel_plate", machine: "blast_furnace", time: 10.0,
        inputs: [("steel_ingot", 2)], outputs: [("steel_plate", 1)], tech: "steelmaking"),
    (id: "forge_steel_rod", machine: "blast_furnace", time: 8.0,
        inputs: [("steel_ingot", 1)], outputs: [("steel_rod", 2)], tech: "steelmaking"),
    (id: "craft_hardened_pickaxe", machine: "anvil", time: 15.0,
        inputs: [("steel_plate", 3), ("steel_rod", 2), ("bronze_gear", 1)],
        outputs: [("hardened_pickaxe", 1)], tech: "hardened_tools"),
    (id: "craft_steel_support", machine: "anvil", time: 6.0,
        inputs: [("steel_rod", 2)], outputs: [("steel_support", 2)], tech: "steelmaking"),

    // ================================================== crusher: era 2
    (id: "crush_iron", machine: "crusher", time: 5.0,
        inputs: [("raw_iron", 1)], outputs: [("crushed_iron_ore", 1)], tech: "ore_processing"),
    (id: "crush_copper", machine: "crusher", time: 5.0,
        inputs: [("raw_copper", 1)], outputs: [("crushed_copper_ore", 1)], tech: "ore_processing"),
    (id: "crush_uranium", machine: "crusher", time: 6.0,
        inputs: [("uranium_ore", 1)], outputs: [("crushed_uranium_ore", 1)], tech: "uranium_milling"),
    (id: "crush_quartz", machine: "crusher", time: 5.0,
        inputs: [("quartz", 2)], outputs: [("silicon", 1)], tech: "electronics"),

    // ================================================== ore washer: era 2
    (id: "wash_ore", machine: "ore_washer", time: 6.0,
        inputs: [("crushed_iron_ore", 1), ("sand", 1)], outputs: [("iron_ingot", 2)],
        tech: "ore_processing"),
    (id: "wash_copper", machine: "ore_washer", time: 6.0,
        inputs: [("crushed_copper_ore", 1), ("sand", 1)], outputs: [("copper_ingot", 2)],
        tech: "ore_processing"),

    // ================================================== arc furnace: era 3
    (id: "arc_smelt_iron", machine: "arc_furnace", time: 4.0,
        inputs: [("raw_iron", 2)], outputs: [("iron_ingot", 3)], tech: "electric_power",
        power_kw: 60.0),
    (id: "arc_smelt_aluminium", machine: "arc_furnace", time: 5.0,
        inputs: [("raw_bauxite", 2)], outputs: [("aluminium_ingot", 1)], tech: "electrochemistry",
        power_kw: 60.0),
    (id: "smelt_aluminium", machine: "arc_furnace", time: 5.0,
        inputs: [("raw_bauxite", 2)], outputs: [("aluminium_ingot", 1)], tech: "electrochemistry",
        power_kw: 60.0),
    (id: "arc_forge_aluminium_plate", machine: "arc_furnace", time: 4.0,
        inputs: [("aluminium_ingot", 2)], outputs: [("aluminium_plate", 1)],
        tech: "electrochemistry", power_kw: 60.0),
    (id: "arc_make_silicon", machine: "arc_furnace", time: 6.0,
        inputs: [("quartz", 2), ("coal", 1)], outputs: [("silicon", 2)], tech: "electronics",
        power_kw: 60.0),
    (id: "smelt_nickel", machine: "arc_furnace", time: 5.0,
        inputs: [("raw_nickel", 2)], outputs: [("nickel_ingot", 1)], tech: "electric_power",
        power_kw: 60.0),
    (id: "smelt_chromium", machine: "arc_furnace", time: 5.0,
        inputs: [("raw_chromium", 2)], outputs: [("chromium_ingot", 1)], tech: "electric_power",
        power_kw: 60.0),
    (id: "smelt_tungsten", machine: "arc_furnace", time: 6.0,
        inputs: [("raw_tungsten", 2)], outputs: [("tungsten_ingot", 1)], tech: "advanced_alloys",
        power_kw: 60.0),
    (id: "smelt_zirconium", machine: "arc_furnace", time: 6.0,
        inputs: [("raw_zircon", 2)], outputs: [("zirconium_ingot", 1)], tech: "advanced_alloys",
        power_kw: 60.0),
    (id: "smelt_gold", machine: "arc_furnace", time: 5.0,
        inputs: [("raw_gold", 2)], outputs: [("gold_ingot", 1)], tech: "electric_power",
        power_kw: 60.0),

    // ================================================== electrolysis: era 3
    (id: "split_salt", machine: "electrolysis_cell", time: 8.0,
        inputs: [("salt", 2)], outputs: [("chlorine", 1), ("lye", 1)], tech: "electrochemistry",
        power_kw: 45.0),
    (id: "make_battery_pack", machine: "electrolysis_cell", time: 12.0,
        inputs: [("lead_plate", 2), ("sulfuric_acid", 2)], outputs: [("battery_pack", 1)],
        tech: "electric_power", power_kw: 45.0),

    // ================================================== circuit assembler: era 3
    (id: "circuit_mk1", machine: "circuit_assembler", time: 8.0,
        inputs: [("silicon", 1), ("copper_wire", 2), ("gold_ingot", 1)],
        outputs: [("circuit_mk1", 1)], tech: "electronics", power_kw: 35.0),
    (id: "circuit_mk2", machine: "circuit_assembler", time: 14.0,
        inputs: [("circuit_mk1", 2), ("silicon", 2), ("rare_earth_magnet", 1)],
        outputs: [("circuit_mk2", 1)], tech: "electronics", power_kw: 35.0),
    (id: "make_speed_module", machine: "circuit_assembler", time: 10.0,
        inputs: [("circuit_mk1", 1), ("steel_gear", 2)], outputs: [("speed_module", 1)],
        tech: "electronics", power_kw: 35.0),
    (id: "make_efficiency_module", machine: "circuit_assembler", time: 10.0,
        inputs: [("circuit_mk1", 1), ("copper_wire", 4)], outputs: [("efficiency_module", 1)],
        tech: "electronics", power_kw: 35.0),

    // ================================================== chemical plant: era 4
    (id: "make_sulfuric_acid", machine: "chemical_plant", time: 12.0,
        inputs: [("sulfur", 2), ("sand", 1)], outputs: [("sulfuric_acid", 2)], tech: "chemistry",
        power_kw: 80.0),
    (id: "make_fluorine", machine: "chemical_plant", time: 14.0,
        inputs: [("fluorite", 2), ("sulfuric_acid", 1)], outputs: [("fluorine_compound", 1)],
        tech: "chemistry", power_kw: 80.0),
    (id: "make_steam_canister", machine: "chemical_plant", time: 6.0,
        inputs: [("steel_plate", 1), ("copper_pipe", 1)], outputs: [("steam_canister", 1)],
        tech: "steam_tools", power_kw: 80.0),

    // ================================================== alloy furnace: era 4
    (id: "smelt_stainless", machine: "alloy_furnace", time: 16.0,
        inputs: [("steel_ingot", 3), ("nickel_ingot", 1), ("chromium_ingot", 1)],
        outputs: [("stainless_ingot", 3)], tech: "advanced_alloys", power_kw: 70.0),
    (id: "make_tungsten_carbide", machine: "alloy_furnace", time: 18.0,
        inputs: [("tungsten_ingot", 2), ("graphite", 2)], outputs: [("tungsten_carbide", 1)],
        tech: "advanced_alloys", power_kw: 70.0),
    (id: "make_stainless_casing", machine: "alloy_furnace", time: 12.0,
        inputs: [("stainless_ingot", 3)], outputs: [("stainless_casing", 1)],
        tech: "advanced_alloys", power_kw: 70.0),
    (id: "make_dense_shielding", machine: "alloy_furnace", time: 14.0,
        inputs: [("depleted_canister", 1), ("lead_plate", 2)],
        outputs: [("dense_shielding_plate", 2)], tech: "waste_handling", power_kw: 70.0),

    // ================================================== machine shop: era 4
    (id: "make_bearing", machine: "machine_shop", time: 10.0,
        inputs: [("steel_rod", 2), ("bronze_gear", 1)], outputs: [("bearing", 1)],
        tech: "precision_manufacturing", power_kw: 50.0),
    (id: "make_turbine_blade", machine: "machine_shop", time: 12.0,
        inputs: [("stainless_ingot", 2), ("bearing", 1)], outputs: [("turbine_blade", 1)],
        tech: "precision_manufacturing", power_kw: 50.0),
    (id: "make_centrifuge_rotor", machine: "machine_shop", time: 16.0,
        inputs: [("tungsten_carbide", 1), ("bearing", 2), ("stainless_casing", 1)],
        outputs: [("centrifuge_rotor", 1)], tech: "precision_manufacturing", power_kw: 50.0),
    (id: "make_steel_gear", machine: "machine_shop", time: 8.0,
        inputs: [("steel_ingot", 2)], outputs: [("steel_gear", 1)],
        tech: "precision_manufacturing", power_kw: 50.0),
    (id: "make_drill_head", machine: "machine_shop", time: 20.0,
        inputs: [("tungsten_carbide", 2), ("steel_plate", 1)], outputs: [("drill_head", 1)],
        tech: "deep_drilling", power_kw: 50.0),
    (id: "make_zirconium_tubing", machine: "machine_shop", time: 12.0,
        inputs: [("zirconium_ingot", 2)], outputs: [("zirconium_tubing", 2)],
        tech: "fuel_fabrication", power_kw: 50.0),

    // ================================================== rare earth separator: era 4
    (id: "make_rare_earth_magnet", machine: "rare_earth_separator", time: 20.0,
        inputs: [("monazite_sand", 2), ("sulfuric_acid", 1)],
        outputs: [("rare_earth_magnet", 1)], tech: "rare_earths", power_kw: 90.0),

    // ================================================== tool assembly: era 2-4
    (id: "craft_steam_drill", machine: "machine_shop", time: 20.0,
        inputs: [("steel_ingot", 6), ("bronze_gear", 4), ("copper_pipe", 4), ("steam_canister", 1)],
        outputs: [("steam_drill", 1)], tech: "steam_tools", power_kw: 50.0),
    (id: "craft_tungsten_drill", machine: "machine_shop", time: 30.0,
        inputs: [("tungsten_carbide", 4), ("drill_head", 1), ("battery_pack", 2), ("bearing", 2)],
        outputs: [("tungsten_drill", 1)], tech: "deep_drilling", power_kw: 50.0),
    (id: "craft_ore_scanner", machine: "circuit_assembler", time: 15.0,
        inputs: [("circuit_mk1", 2), ("glass_pane", 2), ("battery_pack", 1)],
        outputs: [("ore_scanner", 1)], tech: "ore_scanning", power_kw: 35.0),
    (id: "craft_hazmat_suit", machine: "machine_shop", time: 25.0,
        inputs: [("lead_plate", 6), ("stainless_ingot", 4), ("glass_pane", 2)],
        outputs: [("hazmat_suit", 1)], tech: "radiation_safety", power_kw: 50.0),
    (id: "craft_geiger_counter", machine: "circuit_assembler", time: 12.0,
        inputs: [("circuit_mk1", 1), ("lead_plate", 1), ("copper_wire", 4)],
        outputs: [("geiger_counter", 1)], tech: "radiation_safety", power_kw: 35.0),
    (id: "craft_cooling_suit", machine: "machine_shop", time: 20.0,
        inputs: [("aluminium_plate", 4), ("steel_pipe", 4), ("copper_wire", 6)],
        outputs: [("cooling_suit", 1)], tech: "radiation_safety", power_kw: 50.0),
    (id: "craft_respirator", machine: "machine_shop", time: 15.0,
        inputs: [("aluminium_plate", 2), ("steel_pipe", 2)],
        outputs: [("respirator", 1)], tech: "ventilation", power_kw: 50.0),
    (id: "craft_headlamp_mk2", machine: "circuit_assembler", time: 10.0,
        inputs: [("electric_lamp", 1), ("battery_pack", 1), ("copper_wire", 4)],
        outputs: [("headlamp_mk2", 1)], tech: "electronics", power_kw: 35.0),

    // ================================================== nuclear: leaching
    (id: "leach_uranium", machine: "leaching_tank", time: 20.0,
        inputs: [("crushed_uranium_ore", 2), ("sulfuric_acid", 1)],
        outputs: [("uranium_solution", 1), ("radioactive_tailings", 1)],
        tech: "uranium_milling", power_kw: 40.0),
    (id: "precipitate_uranium", machine: "precipitator", time: 16.0,
        inputs: [("uranium_solution", 2), ("lye", 1)], outputs: [("yellowcake", 1)],
        tech: "uranium_milling", power_kw: 35.0),
    (id: "convert_uranium", machine: "conversion_plant", time: 24.0,
        inputs: [("yellowcake", 1), ("fluorine_compound", 1)],
        outputs: [("uranium_hexafluoride", 1)], tech: "uranium_conversion", power_kw: 100.0),
    (id: "enrich_uranium", machine: "centrifuge", time: 30.0,
        inputs: [("uranium_hexafluoride", 1)],
        outputs: [("enriched_canister", 1), ("depleted_canister", 1)],
        tech: "enrichment", power_kw: 150.0),

    // ================================================== nuclear: fuel
    (id: "fabricate_fuel_rod", machine: "fuel_fabricator", time: 26.0,
        inputs: [("enriched_canister", 1), ("zirconium_tubing", 2)],
        outputs: [("fuel_rod", 1)], tech: "fuel_fabrication", power_kw: 80.0),
    (id: "fabricate_core_cell", machine: "fuel_fabricator", time: 30.0,
        inputs: [("enriched_canister", 1), ("stainless_casing", 1), ("lead_plate", 2)],
        outputs: [("compact_core_cell", 1)], tech: "fuel_fabrication", power_kw: 80.0),
    (id: "make_control_rod", machine: "fuel_fabricator", time: 18.0,
        inputs: [("cadmium", 2), ("stainless_ingot", 2)], outputs: [("control_rod", 1)],
        tech: "reactor_engineering", power_kw: 80.0),
    (id: "make_graphite_moderator", machine: "fuel_fabricator", time: 12.0,
        inputs: [("graphite", 4)], outputs: [("graphite_moderator", 1)],
        tech: "reactor_engineering", power_kw: 80.0),

    // ================================================== nuclear: waste
    (id: "make_waste_cask", machine: "alloy_furnace", time: 20.0,
        inputs: [("concrete", 4), ("lead_plate", 2), ("spent_fuel_rod", 1)],
        outputs: [("waste_cask", 1)], tech: "waste_handling", power_kw: 70.0),
    (id: "pack_spent_cell", machine: "alloy_furnace", time: 20.0,
        inputs: [("concrete", 4), ("lead_plate", 2), ("spent_core_cell", 1)],
        outputs: [("waste_cask", 1)], tech: "waste_handling", power_kw: 70.0),

    // ================================================== the prize
    (id: "craft_nuclear_drill", machine: "machine_shop", time: 40.0,
        inputs: [("compact_core_cell", 1), ("drill_head", 2), ("stainless_casing", 2),
                 ("rare_earth_magnet", 2), ("lead_plate", 4)],
        outputs: [("nuclear_drill", 1)], tech: "nuclear_drill", power_kw: 50.0),

    // ================================================== logistics: era 2
    (id: "craft_rail", machine: "anvil", time: 3.0,
        inputs: [("steel_rod", 1), ("timber", 1)], outputs: [("rail", 4)], tech: "logistics"),
    (id: "craft_conveyor", machine: "anvil", time: 3.0,
        inputs: [("iron_plate", 1), ("bronze_gear", 1)], outputs: [("conveyor", 1)],
        tech: "logistics"),
    (id: "craft_item_pipe", machine: "anvil", time: 3.0,
        inputs: [("steel_rod", 2)], outputs: [("item_pipe", 1)], tech: "logistics"),
    (id: "craft_lamp_electric", machine: "circuit_assembler", time: 6.0,
        inputs: [("glass_pane", 1), ("copper_wire", 2)], outputs: [("electric_lamp", 1)],
        tech: "electronics", power_kw: 35.0),
    (id: "craft_lead_shielding", machine: "anvil", time: 8.0,
        inputs: [("lead_plate", 2), ("concrete", 1)], outputs: [("lead_shielding", 1)],
        tech: "radiation_safety"),


    // ================================================== water
    // Water is drawn from the mine by a hand pump; it is the base of most chemistry.
    (id: "pump_water", machine: "hand_pump", time: 4.0,
        inputs: [("sand", 1)], outputs: [("water", 2)], tech: "steam_power"),

    // ================================================== additional processing
    (id: "kiln_charcoal", machine: "brick_kiln", time: 9.0,
        inputs: [("timber", 2)], outputs: [("coal", 1)], tech: "kiln_work"),
    (id: "smelt_gold_furnace", machine: "stone_furnace", time: 8.0,
        inputs: [("raw_gold", 1)], outputs: [("gold_ingot", 1)], tech: "smelting"),
    (id: "crush_tin", machine: "crusher", time: 5.0,
        inputs: [("raw_tin", 1)], outputs: [("crushed_tin_ore", 1)], tech: "ore_processing"),
    (id: "crush_lead", machine: "crusher", time: 5.0,
        inputs: [("raw_lead", 1)], outputs: [("crushed_lead_ore", 1)], tech: "ore_processing"),
    (id: "wash_tin", machine: "ore_washer", time: 6.0,
        inputs: [("crushed_tin_ore", 1), ("sand", 1)], outputs: [("tin_ingot", 2)],
        tech: "ore_processing"),
    (id: "wash_lead", machine: "ore_washer", time: 6.0,
        inputs: [("crushed_lead_ore", 1), ("sand", 1)], outputs: [("lead_ingot", 2)],
        tech: "ore_processing"),
    (id: "wash_uranium", machine: "ore_washer", time: 8.0,
        inputs: [("crushed_uranium_ore", 1), ("water", 1)], outputs: [("crushed_uranium_ore", 2)],
        tech: "uranium_milling"),
    (id: "arc_smelt_steel", machine: "arc_furnace", time: 8.0,
        inputs: [("iron_ingot", 2), ("coal", 2)], outputs: [("steel_ingot", 2)],
        tech: "electric_power", power_kw: 60.0),
    (id: "arc_make_graphite", machine: "arc_furnace", time: 9.0,
        inputs: [("coal", 4)], outputs: [("graphite", 2)], tech: "electric_power", power_kw: 60.0),
    (id: "electrolysis_aluminium", machine: "electrolysis_cell", time: 10.0,
        inputs: [("alumina", 2)], outputs: [("aluminium_ingot", 1)], tech: "electrochemistry",
        power_kw: 45.0),
    (id: "make_alumina", machine: "chemical_plant", time: 8.0,
        inputs: [("raw_bauxite", 2), ("lye", 1)], outputs: [("alumina", 2)], tech: "chemistry",
        power_kw: 80.0),
    (id: "make_circuit_mk3", machine: "circuit_assembler", time: 20.0,
        inputs: [("circuit_mk2", 2), ("gold_ingot", 2), ("rare_earth_magnet", 1)],
        outputs: [("circuit_mk3", 1)], tech: "electronics", power_kw: 35.0),
    (id: "forge_stainless_plate", machine: "alloy_furnace", time: 12.0,
        inputs: [("stainless_ingot", 2)], outputs: [("stainless_plate", 1)],
        tech: "advanced_alloys", power_kw: 70.0),
    (id: "make_steel_pipe", machine: "machine_shop", time: 8.0,
        inputs: [("steel_plate", 1)], outputs: [("steel_pipe", 2)],
        tech: "precision_manufacturing", power_kw: 50.0),
    (id: "separate_monazite", machine: "rare_earth_separator", time: 18.0,
        inputs: [("monazite_sand", 3), ("lye", 1)], outputs: [("rare_earth_oxide", 2)],
