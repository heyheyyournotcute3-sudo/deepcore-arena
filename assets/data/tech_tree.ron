// Deepcore tech tree.
//
// Nodes are team-shared and gate recipes and machines. Each node lists the
// parents that must be researched first and the items the team must deliver to
// the Research Desk.

[
    // ==================================================== era 0: hand tools
    (
        id: "basic_tools",
        name: "Basic Tools",
        era: 0,
        parents: [],
        cost: [("timber", 8), ("stone_cobble", 8)],
        unlocks: ["workbench", "storage_crate"],
    ),
    (
        id: "mining_basics",
        name: "Mining Basics",
        era: 0,
        parents: ["basic_tools"],
        cost: [("timber", 12), ("coal", 4)],
        unlocks: ["ladder", "oil_lamp", "timber_support"],
    ),

    // ======================================================== era 1: smelting
    (
        id: "kiln_work",
        name: "Kiln Work",
        era: 1,
        parents: ["mining_basics"],
        cost: [("clay", 12), ("coal", 8)],
        unlocks: ["brick_kiln", "brick"],
    ),
    (
        id: "smelting",
        name: "Smelting",
        era: 1,
        parents: ["kiln_work"],
        cost: [("brick", 12), ("raw_copper", 6), ("raw_iron", 6)],
        unlocks: ["stone_furnace", "smelt_copper", "smelt_iron", "smelt_tin", "smelt_lead", "smelt_zinc"],
    ),
    (
        id: "smithing",
        name: "Smithing",
        era: 1,
        parents: ["smelting"],
        cost: [("iron_ingot", 8), ("copper_ingot", 4)],
        unlocks: ["anvil", "forge_iron_plate", "forge_copper_plate", "forge_rods"],
    ),
    (
        id: "bronze_working",
        name: "Bronze Working",
        era: 1,
        parents: ["smithing"],
        cost: [("copper_ingot", 6), ("tin_ingot", 4)],
        unlocks: ["smelt_bronze", "forge_bronze_gear"],
    ),
    (
        id: "steelmaking",
        name: "Steelmaking",
        era: 1,
        parents: ["smithing"],
        cost: [("iron_ingot", 16), ("coal", 12), ("limestone", 8)],
        unlocks: ["blast_furnace", "smelt_steel", "forge_steel_plate", "forge_steel_rod"],
    ),
    (
        id: "hardened_tools",
        name: "Hardened Tools",
        era: 1,
        parents: ["steelmaking"],
        cost: [("steel_plate", 8), ("steel_rod", 4)],
        unlocks: ["hardened_pickaxe", "craft_hardened_pickaxe"],
    ),

    // ========================================================== era 2: steam
    (
        id: "steam_power",
        name: "Steam Power",
        era: 2,
        parents: ["steelmaking"],
        cost: [("steel_plate", 20), ("copper_pipe", 10), ("bronze_gear", 5)],
        unlocks: ["steam_boiler", "steam_engine", "copper_pipe_block", "hand_pump"],
    ),
    (
        id: "ore_processing",
        name: "Ore Processing",
        era: 2,
        parents: ["steam_power"],
        cost: [("steel_plate", 16), ("bronze_gear", 8)],
        unlocks: ["crusher", "ore_washer", "crush_iron", "crush_copper", "wash_ore"],
    ),
    (
        id: "logistics",
        name: "Logistics",
        era: 2,
        parents: ["steam_power"],
        cost: [("steel_plate", 12), ("iron_plate", 16), ("timber", 24)],
        unlocks: ["conveyor", "item_pipe", "mine_lift", "rail"],
    ),
    (
        id: "steam_tools",
        name: "Steam Tools",
        era: 2,
        parents: ["ore_processing"],
        cost: [("steel_ingot", 12), ("bronze_gear", 6), ("copper_pipe", 8)],
        unlocks: ["steam_drill", "craft_steam_drill", "steam_canister"],
    ),

    // ====================================================== era 3: electric
    (
        id: "electric_power",
        name: "Electric Power",
        era: 3,
        parents: ["steam_power"],
        cost: [("steel_plate", 20), ("copper_wire", 20), ("battery_pack", 1)],
        unlocks: ["steam_turbine", "generator", "cable_block", "battery_bank", "arc_furnace"],
    ),
    (
        id: "electrochemistry",
        name: "Electrochemistry",
        era: 3,
        parents: ["electric_power"],
        cost: [("aluminium_ingot", 4), ("salt", 8), ("copper_plate", 8)],
        unlocks: ["electrolysis_cell", "smelt_aluminium", "split_salt"],
    ),
    (
        id: "electronics",
        name: "Electronics",
        era: 3,
        parents: ["electric_power", "electrochemistry"],
        cost: [("silicon", 8), ("copper_wire", 12), ("gold_ingot", 2)],
        unlocks: ["circuit_assembler", "circuit_mk1", "circuit_mk2", "charging_station"],
    ),
    (
        id: "ventilation",
        name: "Ventilation",
        era: 3,
        parents: ["electric_power"],
        cost: [("steel_plate", 8), ("copper_wire", 10)],
        unlocks: ["vent_fan", "electric_pump"],
    ),
    (
        id: "ore_scanning",
        name: "Ore Scanning",
        era: 3,
        parents: ["electronics"],
        cost: [("circuit_mk1", 2), ("glass_pane", 4), ("battery_pack", 1)],
        unlocks: ["ore_scanner"],
    ),

    // ====================================================== era 4: chemical
    (
        id: "chemistry",
        name: "Chemistry",
        era: 4,
        parents: ["electrochemistry"],
        cost: [("sulfur", 8), ("salt", 6), ("fluorite", 4)],
        unlocks: ["chemical_plant", "make_sulfuric_acid", "make_fluorine"],
    ),
    (
        id: "advanced_alloys",
        name: "Advanced Alloys",
        era: 4,
        parents: ["chemistry"],
        cost: [("nickel_ingot", 8), ("chromium_ingot", 6), ("graphite", 6)],
        unlocks: ["alloy_furnace", "smelt_stainless", "make_tungsten_carbide"],
    ),
    (
        id: "precision_manufacturing",
        name: "Precision Manufacturing",
        era: 4,
        parents: ["advanced_alloys"],
        cost: [("steel_gear", 6), ("bearing", 4), ("circuit_mk1", 2)],
        unlocks: ["machine_shop", "make_bearing", "make_turbine_blade", "make_centrifuge_rotor"],
    ),
    (
        id: "rare_earths",
        name: "Rare Earths",
        era: 4,
        parents: ["chemistry"],
        cost: [("monazite_sand", 6), ("sulfuric_acid", 4)],
        unlocks: ["rare_earth_separator", "make_rare_earth_magnet"],
    ),
    (
        id: "radiation_safety",
        name: "Radiation Safety",
        era: 4,
        parents: ["chemistry"],
        cost: [("lead_plate", 8), ("stainless_ingot", 4)],
        unlocks: ["decon_shower", "hazmat_suit", "geiger_counter", "craft_hazmat_suit"],
    ),
    (
        id: "deep_drilling",
        name: "Deep Drilling",
        era: 4,
        parents: ["precision_manufacturing"],
        cost: [("tungsten_carbide", 6), ("steel_plate", 10), ("battery_pack", 2)],
        unlocks: ["tungsten_drill", "craft_tungsten_drill", "drill_head"],
    ),

    // ======================================================= era 5: nuclear
    (
        id: "uranium_milling",
        name: "Uranium Milling",
        era: 5,
        parents: ["chemistry"],
        cost: [("uranium_ore", 4), ("sulfuric_acid", 4)],
        unlocks: ["leaching_tank", "precipitator", "leach_uranium", "precipitate_uranium"],
    ),
    (
        id: "uranium_conversion",
        name: "Uranium Conversion",
        era: 5,
        parents: ["uranium_milling", "chemistry"],
        cost: [("yellowcake", 2), ("fluorine_compound", 2)],
        unlocks: ["conversion_plant", "convert_uranium"],
    ),
    (
        id: "enrichment",
        name: "Enrichment",
        era: 5,
        parents: ["uranium_conversion", "precision_manufacturing"],
        cost: [("rare_earth_magnet", 4), ("centrifuge_rotor", 2), ("circuit_mk2", 2)],
        unlocks: ["centrifuge", "enrich_uranium"],
    ),
    (
        id: "fuel_fabrication",
        name: "Fuel Fabrication",
        era: 5,
        parents: ["enrichment"],
        cost: [("enriched_canister", 1), ("zirconium_tubing", 4)],
        unlocks: ["fuel_fabricator", "fabricate_fuel_rod", "fabricate_core_cell"],
    ),
    (
        id: "reactor_engineering",
        name: "Reactor Engineering",
        era: 5,
        parents: ["fuel_fabrication", "advanced_alloys"],
        cost: [("fuel_rod", 2), ("control_rod", 4), ("graphite_moderator", 8)],
        unlocks: ["reactor_casing", "reactor_console", "scram_panel", "coolant_pump", "heat_exchanger"],
    ),
    (
        id: "waste_handling",
        name: "Waste Handling",
        era: 5,
        parents: ["reactor_engineering"],
        cost: [("concrete", 16), ("lead_plate", 8)],
        unlocks: ["cooling_pool", "waste_vault", "waste_cask"],
    ),
    (
        id: "nuclear_drill",
        name: "Nuclear Drill",
        era: 5,
        parents: ["fuel_fabrication", "deep_drilling"],
        cost: [("compact_core_cell", 1), ("drill_head", 2), ("rare_earth_magnet", 2)],
        unlocks: ["nuclear_drill", "craft_nuclear_drill"],
    ),
]
